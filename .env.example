# Copy to .env (`make setup` does it for you) and fill in locally.
# .env is git-ignored; never commit real values. Real environment variables override this file.

# Shared secret clients send in the X-API-Key header. `make setup` fills in a random value.
SENTINEL_API_KEY=

# Only needed if you enable the optional MISP intel provider (app/intel.py: MispProvider).
SENTINEL_INTEL_API_KEY=
SENTINEL_MISP_URL=
